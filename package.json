{
  "name": "copy-markdown-link",
  "version": "1.1.3",
  "private": true,
  "description": "Chrome extension to copy the current page as a Markdown link [title](URL) to clipboard.",
  "author": "=OwO= (https://github.com/ryugaku-hb)",
  "homepage": "https://github.com/ryugaku-hb/copy-markdown-link#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryugaku-hb/copy-markdown-link.git"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "markdown",
    "clipboard",
    "link",
    "browser-extension"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.1.33",
    "@types/node": "^25.0.9",
    "archiver": "^8.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^3.2.7"
  }
}

{
  "compilerOptions": {
    /* 基本选项 */
    "target": "ES2020", // 编译目标版本，支持 ES2020 特性
    "module": "ESNext", // 模块系统，使用 ESNext（现代模块）
    "moduleResolution": "Node", // 模块解析策略，使用 Node.js 风格
    "lib": ["ES2020", "DOM"], // 包含的库文件，支持 ES2020 和 DOM API

    /* 路径别名 */
    "baseUrl": ".", // 解析非相对模块的基础目录
    "paths": {
      "@popup/*": ["src/popup/modules/*"] // 路径别名
    },

    /* 类型检查 */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* 输出目录 */
    "outDir": "dist" // 编译输出目录
  },
  "include": ["src"], // 包含的文件目录
  "exclude": ["node_modules", "dist"] // 排除的文件目录
}

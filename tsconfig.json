{
  "compilerOptions": {
    /* ======================== 基础编译选项 ======================== */
    "target": "ES2020",
    // 编译目标版本：ES2020
    // ✅ 保留现代 JavaScript 特性：
    //   - async/await 异步编程
    //   - Promise 标准对象
    //   - 可选链操作符 (?.)
    //   - 空值合并操作符 (??)
    //   - BigInt 数据类型
    //   - String.matchAll 方法
    // ❌ 不会降级到 ES5 的冗长兼容代码

    "module": "ESNext",
    // 模块系统：ESNext (原生 ES Modules)
    // - 保持 import/export 语法不变
    // - 与现代构建工具 (Vite/Rollup/Webpack) 完美兼容
    // - 支持浏览器原生 <script type="module">

    "moduleResolution": "bundler",
    // 模块解析策略：打包器模式
    // - 支持 package.json 中的 "exports" 和 "imports" 字段
    // - 支持路径别名 (paths) 配置
    // - 文件扩展名可选（无需强制添加 .js/.ts）
    // - 与构建工具行为保持一致

    "lib": ["ES2020", "DOM"],
    // 类型库声明：ES2020 + DOM API
    // ES2020 包含：
    //   - Promise, async/await
    //   - BigInt, Symbol
    //   - Array.flat, Object.fromEntries
    // DOM 包含：
    //   - window, document 全局对象
    //   - HTMLElement, Event 接口
    //   - fetch, addEventListener 等浏览器 API

    /* ======================== 路径映射 ======================== */
    "paths": {
      "@/*": ["./src/*"]
      // @ 别名指向 src 目录，与 vite.config.ts 的 resolve.alias 保持一致
      // 示例：import { storage } from "@/services/storage"
      // 实际指向：./src/services/storage
    },

    /* ======================== 严格类型检查 ======================== */
    "strict": true,
    // 🔥 启用所有严格模式检查
    // 包括：noImplicitAny, strictNullChecks, strictFunctionTypes 等

    /* ======================== 模块和解析选项 ======================== */
    "esModuleInterop": true,
    // 启用 ES 模块互操作性
    // 允许使用 default 导入 CommonJS 模块
    // 解决 import x = require('x') 的兼容性问题

    "skipLibCheck": true,
    // 跳过第三方库的类型检查
    // 显著提升编译速度，避免类型冲突

    "forceConsistentCasingInFileNames": true,
    // 强制文件名大小写一致性
    // 避免在不同操作系统间产生路径问题

    "isolatedModules": true,
    // 独立模块编译模式
    // 确保每个文件都可以被单独编译
    // 与 Vite/esbuild 构建工具完美配合

    /* ======================== 类型声明 ======================== */
    "types": ["chrome", "node"],
    // 全局类型声明
    // 引入 Chrome 扩展 API 类型定义
    // 也包含 Node.js 类型定义（用于构建脚本）

    /* ======================== 输出控制 ======================== */
    "outDir": "dist",
    // 编译输出目录
    // ⚠️ 在 Vite 构建流程中此配置被忽略

    "noEmit": true
    // 禁止编译器输出文件
    // 交由 Vite 进行最终打包构建
    // 保持开发时的快速热重载体验
  },

  /* ======================== 文件包含排除 ======================== */
  "include": [
    "src/**/*",
    // 包含 src 目录下的所有文件
    // ** 表示递归包含子目录
    "tests/**/*",
    // 包含测试文件，让 tsc 也检查测试代码
    "vitest.config.ts"
    // 测试配置同样纳入类型检查
  ],

  "exclude": [
    "node_modules",
    // 排除依赖包目录
    "dist"
    // 排除构建输出目录
  ]
}
